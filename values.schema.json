{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "typo3-kubernetes-chart values",
  "type": "object",
  "definitions": {
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "peers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "string" } },
    "code": {
      "type": "object",
      "properties": {
        "artifact": { "type": "string" },
        "file": { "type": "string", "minLength": 1 },
        "pullSecret": { "type": "string" },
        "sizeLimit": { "type": "string" },
        "oras": {
          "type": "object",
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "retries": { "type": "integer", "minimum": 1 },
            "resources": { "$ref": "#/definitions/resources" }
          }
        },
        "verify": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string", "minLength": 1 },
            "publicKey": { "type": "string" },
            "existingConfigMap": { "type": "string" },
            "ignoreTlog": { "type": "boolean" },
            "attestation": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "type": { "type": "string" }
              }
            },
            "resources": { "$ref": "#/definitions/resources" }
          }
        }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "port": { "$ref": "#/definitions/port" },
        "typo3Context": { "type": "string", "minLength": 1 },
        "readOnlyAppCode": { "type": "boolean" },
        "setup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "commands": { "type": "array", "items": { "type": "string" } },
            "resources": { "$ref": "#/definitions/resources" }
          }
        },
        "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "health": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "host": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "type": "object" },
        "topologySpread": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSkew": { "type": "integer", "minimum": 1 },
            "whenUnsatisfiable": { "type": "string", "enum": ["ScheduleAnyway", "DoNotSchedule"] },
            "topologyKeys": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "extraHosts": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "$ref": "#/definitions/port" },
        "name": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "clientCertificate": { "type": "boolean" },
            "verifyServerCertificate": { "type": "boolean" },
            "caSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "$ref": "#/definitions/port" },
        "tls": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "maxmemory": { "type": "string" },
        "maxmemoryPolicy": {
          "type": "string",
          "enum": ["noeviction", "allkeys-lru", "allkeys-lfu", "allkeys-random", "volatile-lru", "volatile-lfu", "volatile-random", "volatile-ttl"]
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "keys": { "type": "object", "additionalProperties": { "type": "string" } },
        "extra": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "key"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
              "key": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9_.]*[a-z0-9])?$" },
              "property": { "type": "string", "minLength": 1 }
            }
          }
        },
        "externalSecret": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "refreshInterval": { "type": "string" },
            "secretStoreRef": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["SecretStore", "ClusterSecretStore"] },
                "name": { "type": "string" }
              }
            },
            "remoteKey": { "type": "string" },
            "properties": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "internalTls": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "existing": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string", "enum": ["Issuer", "ClusterIssuer"] },
                "group": { "type": "string" }
              }
            }
          }
        },
        "duration": { "type": "string" },
        "renewBefore": { "type": "string" },
        "privateKey": {
          "type": "object",
          "properties": {
            "algorithm": { "type": "string", "enum": ["ECDSA", "RSA", "Ed25519"] },
            "size": { "type": "integer" }
          }
        },
        "reloaderAnnotations": { "type": "boolean" }
      }
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "enum": ["pvc", "s3"] },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "minBytes": { "type": "integer", "minimum": 0 },
        "image": { "type": "string", "minLength": 1 },
        "pvc": { "type": "object" },
        "s3": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string" },
            "bucket": { "type": "string" },
            "prefix": { "type": "string" },
            "existingSecret": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespaceDefaultDeny": { "type": "boolean" },
        "database": { "type": "object", "properties": { "to": { "$ref": "#/definitions/peers" } } },
        "registry": {
          "type": "object",
          "properties": { "to": { "$ref": "#/definitions/peers" }, "port": { "$ref": "#/definitions/port" } }
        },
        "objectStorage": {
          "type": "object",
          "properties": { "to": { "$ref": "#/definitions/peers" }, "port": { "$ref": "#/definitions/port" } }
        },
        "extraAppEgress": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
